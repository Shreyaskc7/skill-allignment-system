APP_NAME=Intelligent Workforce Skill Alignment System
# development | test | production  (production refuses to start with insecure settings)
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/skill_alignment_db

# Public URL of the frontend (CORS + links in emails)
FRONTEND_ORIGIN=http://localhost:5173
# Optional: comma-separated extra origins allowed by CORS
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# REQUIRED: random secret for signing access tokens (at least 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# Must be true when served over HTTPS (required in production)
COOKIE_SECURE=false

# Schema is managed by Alembic: run `alembic upgrade head` (back up first).
# AUTO_MIGRATE=true runs it automatically at startup.
AUTO_MIGRATE=false

# Login/registration/reset attempts per minute per IP
RATE_LIMIT_AUTH=10

# Optional email (password reset, mentor invitations). Without SMTP_HOST, development
# mode prints emails, including links, to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=SkillAlign <no-reply@example.com>
SMTP_STARTTLS=true
