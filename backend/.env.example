APP_NAME=Intelligent Workforce Skill Alignment System
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/skill_alignment_db
FRONTEND_ORIGIN=http://localhost:5173
CREATE_TABLES_ON_START=true
# Optional: comma-separated extra origins allowed by CORS (FRONTEND_ORIGIN is always allowed)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
