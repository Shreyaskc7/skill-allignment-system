# Where the Vite dev server forwards /api requests (the FastAPI backend).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Leave empty so the browser calls the API on the same origin (required for the
# secure refresh cookie). Only set it when the API is served from another origin
# that is configured for cross-site cookies.
VITE_API_BASE_URL=
