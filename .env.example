# SkillAlign configuration template.
# Copy this file to `.env` in the same folder (start.bat / start.sh do it for you) and fill it in.
# `.env` is git-ignored: it is the ONE place for your credentials. Never commit it.

# ---------------------------------------------------------------- application
APP_ENV=development
# APP_NAME=Intelligent Workforce Skill Alignment System
# API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------- database (PostgreSQL)
# Your local PostgreSQL user, password and database. URL-encode @ : / # % in the password.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/skill_alignment_db

# Used only by docker-compose.yml (keep the password the same as in DATABASE_URL).
POSTGRES_DB=skill_alignment_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_PORT=5432

# ---------------------------------------------------------------- security
# Random secret (48+ characters) for signing tokens. Left empty, the start script generates one.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# true when served over HTTPS (required in production)
COOKIE_SECURE=false
RATE_LIMIT_AUTH=10

# ---------------------------------------------------------------- frontend / CORS
FRONTEND_ORIGIN=http://127.0.0.1:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------- email (optional)
# Without SMTP_HOST, password-reset and invitation emails are printed to the API console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=SkillAlign <no-reply@example.com>
SMTP_STARTTLS=true

# ---------------------------------------------------------------- migrations
# Run `alembic upgrade head` automatically at API start (off: the start script asks first).
AUTO_MIGRATE=false
